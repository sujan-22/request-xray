      "text": "{\"@odata.context\":\"https://api.fernwood.example/api/$metadata#Products/$entity\",\"@odata.etag\":\"W/\\\"899444\\\"\",\"RecordId\":68719478272,\"ItemId\":\"FW-10002\",\"Name\":\"Northbank Waterproof Boot\",\"Description\":\"Northbank Waterproof Boot built for wet trails and long days. Recycled mesh upper, cushioned midsole and a grippy lug outsole.\",\"SearchName\":\"NORTHBANK WATERPROOF BOOT\",\"ProductNumber\":\"FW10002\",\"Price\":92.99,\"BasePrice\":92.99,\"AdjustedPrice\":92.99,\"CustomerContextualPrice\":92.99,\"Currency\":\"CAD\",\"Color\":\"Clay\",\"Size\":null,\"Style\":\"Trail\",\"Configuration\":null,\"IsGiftCard\":false,\"IsMasterProduct\":true,\"MasterProductId\":null,\"IsKit\":false,\"IsRemote\":false,\"PrimaryImageUrl\":\"https://cdn.fernwood.example/products/68719478272/primary.webp\",\"DefaultUnitOfMeasure\":\"ea\",\"ItemTaxGroupId\":\"FULL\",\"SalesTaxGroupId\":\"ON\",\"ProductTypeValue\":4,\"HasLinkedProducts\":false,\"IsDiscontinued\":false,\"DisplayOrder\":2,\"Rating\":3.6,\"ReviewCount\":49,\"WeightGrams\":672,\"CountryOfOrigin\":\"VN\",\"Materials\":[\"Recycled polyester mesh\",\"EVA midsole\",\"Rubber outsole\"],\"CareInstructions\":\"Brush off dirt, rinse with cold water and air dry away from direct heat.\",\"ChannelId\":5637144592,\"CatalogId\":68719478001,\"CategoryIds\":[68719478101,68719478117,68719478140],\"Dimensions\":[{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Moss\",\"RecordId\":68719478273}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Charcoal\",\"RecordId\":68719478274}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Clay\",\"RecordId\":68719478275}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Fog\",\"RecordId\":68719478276}}],\"Behavior\":{\"HasSerialNumber\":false,\"IsDiscountAllowed\":true,\"IsManualDiscountAllowed\":true,\"IsKitDisassemblyAllowed\":false,\"IsNegativeQuantityAllowed\":false,\"IsReturnAllowed\":true,\"IsSaleAtPhysicalStoresAllowed\":true,\"I