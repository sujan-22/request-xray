     "cookies": [],
     "content": {
      "size": 10630,
      "mimeType": "application/json",
      "text": "{\"@odata.context\":\"https://api.fernwood.example/api/$metadata#Products/$entity\",\"@odata.etag\":\"W/\\\"402080\\\"\",\"RecordId\":68719478270,\"ItemId\":\"FW-10000\",\"Name\":\"Ridgeline Trail Runner\",\"Description\":\"Ridgeline Trail Runner built for wet trails and long days. Recycled mesh upper, cushioned midsole and a grippy lug outsole.\",\"SearchName\":\"RIDGELINE TRAIL RUNNER\",\"ProductNumber\":\"FW10000\",\"Price\":183.99,\"BasePrice\":183.99,\"AdjustedPrice\":183.99,\"CustomerContextualPrice\":183.99,\"Currency\":\"CAD\",\"Color\":\"Clay\",\"Size\":null,\"Style\":\"Hike\",\"Configuration\":null,\"IsGiftCard\":false,\"IsMasterProduct\":true,\"MasterProductId\":null,\"IsKit\":false,\"IsRemote\":false,\"PrimaryImageUrl\":\"https://cdn.fernwood.example/products/68719478270/primary.webp\",\"DefaultUnitOfMeasure\":\"ea\",\"ItemTaxGroupId\":\"FULL\",\"SalesTaxGroupId\":\"ON\",\"ProductTypeValue\":4,\"HasLinkedProducts\":false,\"IsDiscontinued\":false,\"DisplayOrder\":0,\"Rating\":4.4,\"ReviewCount\":19,\"WeightGrams\":821,\"CountryOfOrigin\":\"PT\",\"Materials\":[\"Recycled polyester mesh\",\"EVA midsole\",\"Rubber outsole\"],\"CareInstructions\":\"Brush off dirt, rinse with cold water and air dry away from direct heat.\",\"ChannelId\":5637144592,\"CatalogId\":68719478001,\"CategoryIds\":[68719478101,68719478117,68719478140],\"Dimensions\":[{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Moss\",\"RecordId\":68719478271}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Charcoal\",\"RecordId\":68719478272}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Clay\",\"RecordId\":68719478273}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Fog\",\"RecordId\":68719478274}}],\"Behavior\":{\"HasSerialNumber\":false,\"IsDiscountAllowed\":true,\"IsManualDiscountAllowed\":true,\"IsKitDisassemblyAllowed\":false,\"IsNegativeQuantityAllowed\":false,\"IsReturnAllowed\":true,\"IsSaleAtPhysicalStoresAllowed\":true,\"IsZeroSalePriceAllowed\":false,\"KeyInPriceValue\":0,\"KeyInQuantityValue\":0,\"MustKeyInComment\":false,\"MustPrintIndividualShelfLabelsForVariants\":false,\"MustPromptForSerialNumberOnlyAtSale\":false,\"MustWeighProductAtSale\":false,\"ValidFromDateForSaleAtPhysicalStores\":\"1900-01-01T00:00:00Z\",\"ValidToDateForSaleAtPhysicalStores\":\"2154-12-31T00:00:00Z\"},\"LongDescription\":\"<p>Ridgeline Trail Runner pairs a breathable recycled mesh upper with a waterproof membrane, so feet stay dry on wet trails without overheating on the climb.</p><ul><li>Waterproof, breathable membrane</li><li>Recycled mesh and suede upper</li><li>Dual-density EVA midsole</li><li>5 mm lugs for loose ground</li><li>Removable, washable insole</li></ul><p>Fit: true to size. Wide sizes available in selected colours.</p>\",\"Variants\":[{\"RecordId\":6871947827000,\"ItemId\":\"FW-10000-MOSS-7\",\"Size\":\"7\",\"Color\":\"Moss\",\"Barcode\":\"0678719478270\",\"InStock\":true,\"AdjustedPrice\":183.99},{\"RecordId\":6871947827001,\"ItemId\":\"FW-10000-CHARCOAL-7\",\"Size\":\"7\",\"Color\":\"Charcoal\",\"Barcode\":\"0678719478271\",\"InStock\":false,\"AdjustedPrice\":183.99},{\"RecordId\":6871947827002,\"ItemId\":\"FW-10000-CLAY-7\",\"Size\":\"7\",\"Color\":\"Clay\",\"Barcode\":\"0678719478272\",\"InStock\":true,\"AdjustedPrice\":183.99},{\"RecordId\":6871947827003,\"ItemId\":\"FW-10000-FOG-7\",\"Size\":\"7\",\"Color\":\"Fog\",\"Barcode\":\"0678719478273\",\"InStock\":true,\"AdjustedPrice\":183.99},{\"RecordId\":6871947827004,\"ItemId\":\"FW-10000-PINE-7\",\"Size\":\"7\",\"Color\":\"Pine\",\"Barcode\":\"0678719478274\",\"InStock\":true,\"AdjustedPrice\":183.99},{\"RecordId\":6871947827003,\"ItemId\":\"FW-10000-MOSS-7.5\",\"Size\":\"7.5\",\"Color\":\"Moss\",\"Barcode\":\"0678719478273\",\"InStock\":true,\"AdjustedPrice\":183.99},{\"RecordId\":6871947827004,\"ItemId\":\"FW-10000-CHARCOAL-7.5\",\"Size\":\"7.5\",\"Color\":\"Charcoal\",\"Barcode\":\"0678719478274\",\"InStock\":true,\"AdjustedPrice\":183.99