      "text": "{\"@odata.context\":\"https://api.fernwood.example/api/$metadata#Products/$entity\",\"@odata.etag\":\"W/\\\"291848\\\"\",\"RecordId\":68719478276,\"ItemId\":\"FW-10006\",\"Name\":\"Summit Pass Mountaineer\",\"Description\":\"Summit Pass Mountaineer built for wet trails and long days. Recycled mesh upper, cushioned midsole and a grippy lug outsole.\",\"SearchName\":\"SUMMIT PASS MOUNTAINEER\",\"ProductNumber\":\"FW10006\",\"Price\":208.99,\"BasePrice\":208.99,\"AdjustedPrice\":208.99,\"CustomerContextualPrice\":208.99,\"Currency\":\"CAD\",\"Color\":\"Pine\",\"Size\":null,\"Style\":\"Everyday\",\"Configuration\":null,\"IsGiftCard\":false,\"IsMasterProduct\":true,\"MasterProductId\":null,\"IsKit\":false,\"IsRemote\":false,\"PrimaryImageUrl\":\"https://cdn.fernwood.example/products/68719478276/primary.webp\",\"DefaultUnitOfMeasure\":\"ea\",\"ItemTaxGroupId\":\"FULL\",\"SalesTaxGroupId\":\"ON\",\"ProductTypeValue\":4,\"HasLinkedProducts\":false,\"IsDiscontinued\":false,\"DisplayOrder\":6,\"Rating\":4.3,\"ReviewCount\":176,\"WeightGrams\":670,\"CountryOfOrigin\":\"VN\",\"Materials\":[\"Recycled polyester mesh\",\"EVA midsole\",\"Rubber outsole\"],\"CareInstructions\":\"Brush off dirt, rinse with cold water and air dry away from direct heat.\",\"ChannelId\":5637144592,\"CatalogId\":68719478001,\"CategoryIds\":[68719478101,68719478117,68719478140],\"Dimensions\":[{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Moss\",\"RecordId\":68719478277}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Charcoal\",\"RecordId\":68719478278}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Clay\",\"RecordId\":68719478279}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Fog\",\"RecordId\":68719478280}}],\"Behavior\":{\"HasSerialNumber\":false,\"IsDiscountAllowed\":true,\"IsManualDiscountAllowed\":true,\"IsKitDisassemblyAllowed\":false,\"IsNegativeQuantityAllowed\":false,\"IsReturnAllowed\":true,\"IsSaleAtPhysicalStoresAllowed\":true,\"IsZeroSalePriceAllowed\":false,\"KeyInPriceValue\":0,\"KeyInQuantityValue\":0,\"MustKeyInComment\":false,\"MustPrintIndividualShelfLabelsForVariants\":false,\"MustPromptForSerialNumberOnlyAtSale\":false,\"MustWeighProductAtSale\":false,\"ValidFromDateForSaleAtPhysicalStores\":\"1900-01-01T00:00:00Z\",\"ValidToDateForSaleAtPhysicalStores\":\"2154-12-31T00:00:00Z\"},\"LongDescription\":\"<p>Summit Pass Mountaineer pairs a breathable recycled mesh upper with a waterproof membrane, so feet stay dry on wet trails without overheating on the climb.</p><ul><li>Waterproof, breathable membrane</li><li>Recycled mesh and suede upper</li><li>Dual-density EVA midsole</li><li>5 mm lugs for loose ground</li><li>Removable, washable insole</li></ul><p>Fit: true to size. Wide sizes available in selected colours.</p>\",\"Variants\":[{\"RecordId\":6871947827600,\"ItemId\":\"FW-10006-MOSS-7\",\"Size\":\"7\",\"Color\":\"Moss\",\"Barcode\":\"0678719478276\",\"InStock\":true,\"AdjustedPrice\":208.99},{\"RecordId\":6871947827601,\"ItemId\":\"FW-10006-CHARCOAL-7\",\"Size\":\"7\",\"Color\":\"Charcoal\",\"Barcode\":\"0678719478277\",\"InStock\":false,\"AdjustedPrice\":208.99},{\"RecordId\":6871947827602,\"ItemId\":\"FW-10006-CLAY-7\",\"Size\":\"7\",\"Color\":\"Clay\",\"Barcode\":\"0678719478278\",\"InStock\":true,\"AdjustedPrice\":208.99},{\"RecordId\":6871947827603,\"ItemId\":\"FW-10006-FOG-7\",\"Size\":\"7\",\"Color\":\"Fog\",\"Barcode\":\"0678719478279\",\"InStock\":true,\"AdjustedPrice\":208.99},{\"RecordId\":6871947827604,\"ItemId\":\"FW-10006-PINE-7\",\"Size\":\"7\",\"Color\":\"Pine\",\"Barcode\":\"0678719478280\",\"InStock\":true,\"AdjustedPrice\":208.99},{\"RecordId\":6871947827603,\"ItemId\":\"FW-10006-MOSS-7.5\",\"Size\":\"7.5\",\"Color\":\"Moss\",\"Barcode\":\"0678719478279\",\"InStock\":true,\"AdjustedPrice\":208.99},{\"RecordId\":6871947827604,\"ItemId\":\"FW-10006-CHARCOAL-7.5\",\"Size\":\"7.5\",\"Color\":\"Charcoal\",\"Barcode\":\"0678719478280\",\"InStock\":true,\"AdjustedPrice