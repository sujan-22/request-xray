      "text": "{\"@odata.context\":\"https://api.fernwood.example/api/$metadata#Products/$entity\",\"@odata.etag\":\"W/\\\"396862\\\"\",\"RecordId\":68719478277,\"ItemId\":\"FW-10007\",\"Name\":\"Fernwood Everyday Sneaker\",\"Description\":\"Fernwood Everyday Sneaker built for wet trails and long days. Recycled mesh upper, cushioned midsole and a grippy lug outsole.\",\"SearchName\":\"FERNWOOD EVERYDAY SNEAKER\",\"ProductNumber\":\"FW10007\",\"Price\":148.99,\"BasePrice\":148.99,\"AdjustedPrice\":148.99,\"CustomerContextualPrice\":148.99,\"Currency\":\"CAD\",\"Color\":\"Slate\",\"Size\":null,\"Style\":\"Trail\",\"Configuration\":null,\"IsGiftCard\":false,\"IsMasterProduct\":true,\"MasterProductId\":null,\"IsKit\":false,\"IsRemote\":false,\"PrimaryImageUrl\":\"https://cdn.fernwood.example/products/68719478277/primary.webp\",\"DefaultUnitOfMeasure\":\"ea\",\"ItemTaxGroupId\":\"FULL\",\"SalesTaxGroupId\":\"ON\",\"ProductTypeValue\":4,\"HasLinkedProducts\":false,\"IsDiscontinued\":false,\"DisplayOrder\":7,\"Rating\":4,\"ReviewCount\":182,\"WeightGrams\":1135,\"CountryOfOrigin\":\"PT\",\"Materials\":[\"Recycled polyester mesh\",\"EVA midsole\",\"Rubber outsole\"],\"CareInstructions\":\"Brush off dirt, rinse with cold water and air dry away from direct heat.\",\"ChannelId\":5637144592,\"CatalogId\":68719478001,\"CategoryIds\":[68719478101,68719478117,68719478140],\"Dimensions\":[{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Moss\",\"RecordId\":68719478278}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Charcoal\",\"RecordId\":68719478279}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Clay\",\"RecordId\":68719478280}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Fog\",\"RecordId\":68719478281}}],\"Behavior\":{\"HasSerialNumber\":false,\"IsDiscountAllowed\":true,\"IsManualDiscountAllowed\":true,\"IsKitDisassemblyAllowed\":false,\"IsNegativeQuantityAllowed\":false,\"IsReturnAllowed\":true,\"IsSaleAtPhysicalStoresAllowed\":tru