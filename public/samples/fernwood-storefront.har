     "content": {
      "size": 10619,
      "mimeType": "application/json",
      "text": "{\"@odata.context\":\"https://api.fernwood.example/api/$metadata#Products/$entity\",\"@odata.etag\":\"W/\\\"823226\\\"\",\"RecordId\":68719478280,\"ItemId\":\"FW-10010\",\"Name\":\"Kettle Lake Trail Mid\",\"Description\":\"Kettle Lake Trail Mid built for wet trails and long days. Recycled mesh upper, cushioned midsole and a grippy lug outsole.\",\"SearchName\":\"KETTLE LAKE TRAIL MID\",\"ProductNumber\":\"FW10010\",\"Price\":173.99,\"BasePrice\":173.99,\"AdjustedPrice\":173.99,\"CustomerContextualPrice\":173.99,\"Currency\":\"CAD\",\"Color\":\"Clay\",\"Size\":null,\"Style\":\"Hike\",\"Configuration\":null,\"IsGiftCard\":false,\"IsMasterProduct\":true,\"MasterProductId\":null,\"IsKit\":false,\"IsRemote\":false,\"PrimaryImageUrl\":\"https://cdn.fernwood.example/products/68719478280/primary.webp\",\"DefaultUnitOfMeasure\":\"ea\",\"ItemTaxGroupId\":\"FULL\",\"SalesTaxGroupId\":\"ON\",\"ProductTypeValue\":4,\"HasLinkedProducts\":false,\"IsDiscontinued\":false,\"DisplayOrder\":10,\"Rating\":4,\"ReviewCount\":435,\"WeightGrams\":776,\"CountryOfOrigin\":\"CA\",\"Materials\":[\"Recycled polyester mesh\",\"EVA midsole\",\"Rubber outsole\"],\"CareInstructions\":\"Brush off dirt, rinse with cold water and air dry away from direct heat.\",\"ChannelId\":5637144592,\"CatalogId\":68719478001,\"CategoryIds\":[68719478101,68719478117,68719478140],\"Dimensions\":[{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Moss\",\"RecordId\":68719478281}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Charcoal\",\"RecordId\":68719478282}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Clay\",\"RecordId\":68719478283}},{\"DimensionTypeValue\":1,\"DimensionValue\":{\"Value\":\"Fog\",\"RecordId\":68719478284}}],\"Behavior\":{\"HasSerialNumber\":false,\"IsDiscountAllowed\":true,\"IsManualDiscountAllowed\":true,\"IsKitDisassemblyAllowed\":false,\"IsNegativeQuantityAllowed\":false,\"IsReturnAllowed\":true,\"IsSaleAtPhysicalStoresAllowed\":true,\"IsZeroSalePriceAllowed\":false,\"KeyInPriceValue\":0,\"KeyInQuantityValue\":0,\"MustKeyInComment\":false,\"MustPrintIndividualShelfLabelsForVariants\":false,\"MustPromptForSerialNumberOnlyAtSale\":false,\"MustWeighProductAtSale\":false,\"ValidFromDateForSaleAtPhysicalStores\":\"1900-01-01T00:00:00Z\",\"ValidToDateForSaleAtPhysicalStores\":\"2154-12-31T00:00:00Z\"},\"LongDescription\":\"<p>Kettle Lake Trail Mid pairs a breathable recycled mesh upper with a waterproof membrane, so feet stay dry on wet trails without overheating on the climb.</p><ul><li>Waterproof, breathable membrane</li><li>Recycled mesh and suede upper</li><li>Dual-density EVA midsole</li><li>5 mm lugs for loose ground</li><li>Removable, washable insole</li></ul><p>Fit: true to size. Wide sizes available in selected colours.</p>\",\"Variants\":[{\"RecordId\":6871947828000,\"ItemId\":\"FW-10010-MOSS-7\",\"Size\":\"7\",\"Color\":\"Moss\",\"Barcode\":\"0678719478280\",\"InStock\":true,\"AdjustedPrice\":173.99},{\"RecordId\":6871947828001,\"ItemId\":\"FW-10010-CHARCOAL-7\",\"Size\":\"7\",\"Color\":\"Charcoal\",\"Barcode\":\"0678719478281\",\"InStock\":true,\"AdjustedPrice\":173.99},{\"RecordId\":6871947828002,\"ItemId\":\"FW-10010-CLAY-7\",\"Size\":\"7\",\"Color\":\"Clay\",\"Barcode\":\"0678719478282\",\"InStock\":true,\"AdjustedPrice\":173.99},{\"RecordId\":6871947828003,\"ItemId\":\"FW-10010-FOG-7\",\"Size\":\"7\",\"Color\":\"Fog\",\"Barcode\":\"0678719478283\",\"InStock\":true,\"AdjustedPrice\":173.99},{\"RecordId\":6871947828004,\"ItemId\":\"FW-10010-PINE-7\",\"Size\":\"7\",\"Color\":\"Pine\",\"Barcode\":\"0678719478284\",\"InStock\":false,\"AdjustedPrice\":173.99},{\"RecordId\":6871947828003,\"ItemId\":\"FW-10010-MOSS-7.5\",\"Size\":\"7.5\",\"Color\":\"Moss\",\"Barcode\":\"0678719478283\",\"InStock\":true,\"AdjustedPrice\":173.99},{\"RecordId\":6871947828004,\"ItemId\":\"FW-10010-CHARCOAL-7.5\",\"Size\":\"7.5\",\"Color\":\"Charcoal\",\"Barcode\":\"0678719478284\",\"InStock\":true,\"AdjustedPrice\":173.99},{\